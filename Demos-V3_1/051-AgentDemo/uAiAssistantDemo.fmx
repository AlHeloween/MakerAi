  object AiPrompts1: TAiPrompts
    Items = <
      item
        Nombre = 'AiPrompt'
        Strings.Strings = (
          ''
          'generates a console program in Delphi Pascal latest version'
          'Console programs do have the .dpr extension and '
          'have the following structure'
          ''
          'program Nombre_del_Proyecto;'
          ''
          '{$APPTYPE CONSOLE}'
          ''
          'uses'
          '  System.SysUtils, Otras_Unidades_que_se_requieran;'
          ''
          'begin'
          '  try'
          ''
          '    { TODO -oUser -cConsole Main : Insert code here }'
          ''
          ''
          '   Write('#39'press enter to finish'#39');'
          '   Readln;'
          '  except'
          '    on E: Exception do'
          '      Writeln(E.ClassName, '#39': '#39', E.Message);'
          '  end;'
          'end.'
          ''
          ''
          
            'When generating the code, you must take into account that the ' +
            'Nombre_del_Proyecto must'
          
            'be unique and there cannot be a variable or class with the same ' +
            'name.'
          ''
          ''
          'Generate a json as follows'
          '{'
          '  "languaje":"lenguaje_de_programacion",'
          '  "filename":"nombre_del_archivo_sin_ruta",'
          '  "codigo":"codigo_generado",'
          '}'
          ''
          'The code refers to:'
          '<#prompt>')
      end
      item
        Nombre = 'Eval'
        Strings.Strings = (
          'The following text corresponds to the result of compiling '
          'an application in Delphi with the DCC64 command line, '
          'review the text for error messages which can be '
          
            'represented by the words Fatal or Error, here are' +
            ' two examples:'
          '  Example1: Fatal: F2613 Unit '#39#39'Classes'#39#39' not found.'
          
            '  Example2: Error: E2009 Incompatible types: '#39'method pointer and' +
            ' regular procedure'#39' '
          ''
          ''
          
            'If the text shows no error, it returns the word ' +
            '<CONFIRMED>,'
          
            'but if resultado_compilacion shows any error, it returns the word ' +
            '<ERROR> and the error message ahead. Example: ' +
            '<ERROR>:Fatal: F2613 Unit '#39#39'Classes'#39#39' not found. '
          ''
          ''
          'The message returned by the compiler is the following:'
          '<#resultado>)')
      end>
    PPMRegistryUrl = 'https://registry.cimamaker.com'
    Left = 504
    Top = 192
  end
