      object Layout4: TLayout
        Align = Client
        Size.Width = 1121.000000000000000000
        Size.Height = 638.000000000000000000
        Size.PlatformDefault = False
        TabOrder = 3
        object Memo1: TMemo
          Touch.InteractiveGestures = [Pan, LongTap, DoubleTap]
          DataDetectorTypes = []
          Lines.Strings = (
            '--------------------------------------'
            '        '#55357#56960' HOW IT WORKS '#55357#56960
            '--------------------------------------'
            'The magic is in what you attach:'
            ''
            ''
            #9997#65039'  No Attached Files'
            '    Action: TEXT TO VIDEO'
            '    Write your idea and VEO will create a'
            '    video from scratch.'
            ''
            ''
            #55357#56526'  With 1 Attached File'
            ''
            '    '#55357#56764#65039'  If it is an IMAGE:'
            '        Action: IMAGE TO VIDEO'
            '        VEO will animate your image based'
            '        on the prompt.'
            ''
            '    '#55356#57246#65039'  If it is a VIDEO (from VEO):'
            '        Action: VIDEO EXTENSION'
            '        VEO will continue the story.'
            '        (Remember that it needs its'
            '        .veometa file associated!)'
            ''
            ''
            #55357#56764#65039'+'#55357#56764#65039'  With 2 Attached Images'
            '    This is where you choose the "Mode"!'
            ''
            '    - Automatic or Interpolate Mode:'
            '      Creates a smooth transition between'
            '      the first and second image.'
            ''
            '    - Style Reference Mode:'
            '      Uses both images as'
            '      visual inspiration.'
            ''
            ''
            #55356#57256'  With 3 Attached Images'
            '    Action: STYLE REFERENCE'
            '    VEO will use the images to'
            '    maintain the appearance of'
            '    personajes u objetos.'
            ''
            ''
            '--------------------------------------'
            ' '#55358#56596' WHEN TO CHANGE THE "MODE"? '#55358#56596
            '--------------------------------------'
            'Use the Mode selectors for cases'
            'specific, mainly with 2'
            'images.'
            ''
            ''
            #9898' Automatic'
            '   The safe option. Leave it here and the'
            '   demo will make the most common decision.'
            '   For 2 images, it will assume INTERPOLATE.'
            ''
            ''
            #9898' Interpolar'
            '   Select this if you want to create a'
            '   smooth transition between 2 images'
            '   (de un punto A -> a un punto B).'
            ''
            ''
            #55357#56629' Style Reference'
            '   Select this so VEO copies'
            '   the appearance of the subjects in'
            '   1, 2 or 3 images.'
            ''
            ''
            '======================================'
            '     Now to create! '#55356#57253
            '======================================')
          ReadOnly = True
          TextSettings.WordWrap = True
          Align = Right
          Position.X = 778.000000000000000000
          Size.Width = 343.000000000000000000
          Size.Height = 638.000000000000000000
          Size.PlatformDefault = False
          TabOrder = 1
          Viewport.Width = 343.000000000000000000
          Viewport.Height = 638.000000000000000000
        end
